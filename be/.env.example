# Environment variables cho PlanWise Backend
# Copy file này thành .env và điền giá trị thực

# ── PostgreSQL ────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/planwise
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate secret: openssl rand -base64 64
JWT_SECRET=ZmFrZS1zZWNyZXQtZm9yLWRldi1tdXN0LWJlLWF0LWxlYXN0LTI1Ni1iaXRzLWxvbmctcGxhbndpc2U=

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# Tạo tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── VNPAY PAYMENT ─────────────────────────────────────────────

VNPAY_TMN_CODE=RPIX4AXS
VNPAY_HASH_SECRET=EA6GKA59U9OSPDRC7EX4MYJ2S90WTYI0

VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

VNPAY_RETURN_URL=http://localhost:5173/payment-success

VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay-ipn

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── AI Provider Configuration ─────────────────────────────────────────────────
AI_CLAUDE_API_KEY=your-claude-api-key
AI_CLAUDE_MODEL=claude-sonnet-4-6
AI_CLAUDE_URL=https://modelapi.vn/v1/messages
AI_CLAUDE_MAX_TOKENS=4096