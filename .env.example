# ============================================
# PlanWise - Environment Configuration
# ============================================
# Copy this file to .env at the repository root and fill in your values

# ── PostgreSQL Connection ──────────────────────────────────────────────────────
# For Docker: use host.docker.internal (Windows/Mac) or bridge IP (Linux)
# SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/planwise
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/planwise
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_SECURE_PASSWORD_HERE
POSTGRES_DB=planwise

# ── JWT Secret (generate: openssl rand -base64 64) ───────────────────────────
JWT_SECRET=YOUR_JWT_SECRET_BASE64_HERE

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Email Configuration ───────────────────────────────────────────────────────
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password

# ── Server Configuration ──────────────────────────────────────────────────────
SERVER_PORT=8080
HTTP_PORT=80

# Keep empty when frontend and backend share one domain through Nginx.
VITE_API_BASE_URL=

# ── URLs ─────────────────────────────────────────────────────────────────────
APP_MAIL_VERIFICATION_BASE_URL=http://planwise.q2k.click/verify-email
VNPAY_RETURN_URL=http://planwise.q2k.click/payment/result

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://planwise.q2k.click,http://localhost:5173

# ── Payment (VNPay) ───────────────────────────────────────────────────────────
VNPAY_TMN_CODE=YOUR_TMN_CODE
VNPAY_HASH_SECRET=YOUR_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# ── MoMo Payment ─────────────────────────────────────────────────────────────
MOMO_PARTNER_CODE=YOUR_PARTNER_CODE
MOMO_ACCESS_KEY=YOUR_ACCESS_KEY
MOMO_SECRET_KEY=YOUR_SECRET_KEY
MOMO_URL=https://test-payment.momo.vn/v2/gateway/pay/create
